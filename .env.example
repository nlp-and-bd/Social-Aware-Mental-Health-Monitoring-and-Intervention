# --- Reddit OAuth ---
# Login uses the user-OAuth (identity) flow, so the Reddit app MUST be type "web app"
# (NOT "script") with redirect URI exactly matching REDDIT_REDIRECT_URI below.
# The same client credentials are reused (app-only) to fetch a user's public posts.
# Create app at https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=python:penumbra:1.0.0 (by /u/<your_reddit_username>)
REDDIT_REDIRECT_URI=http://localhost:8002/api/auth/callback
REDDIT_OAUTH_SCOPES=identity
REDDIT_RECENT_WINDOW_DAYS=90
# Where the OAuth callback redirects the browser back to (the Next.js frontend)
FRONTEND_BASE_URL=http://localhost:3000


# --- MongoDB Atlas ---
# Format: mongodb+srv://<user>:<pwd>@<cluster>.mongodb.net/?retryWrites=true&w=majority&appName=<app>
MONGODB_URI=
MONGODB_DB=mental_health_db

MONGO_DB_RAW=mh_raw
MONGO_DB_PII=mh_pii
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Optional: override the primary endpoint (leave blank to use OpenAI as-is).
OPENAI_BASE_URL=

# Optional fallback LLM — used ONLY when the primary OpenAI call fails
# (e.g. 429 insufficient_quota). OpenAI stays primary; this is the safety net.
# Free example — Groq (create a key at https://console.groq.com):
#   FALLBACK_API_KEY=<your groq key>
#   FALLBACK_BASE_URL=https://api.groq.com/openai/v1
#   FALLBACK_MODEL=llama-3.3-70b-versatile
FALLBACK_API_KEY=
FALLBACK_BASE_URL=
FALLBACK_MODEL=llama-3.3-70b-versatile

# --- Encryption key for usernames in mh_pii ---
# Generate once with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=
MENTALBERT_MODEL_PATH=./models/v2
EMBEDDING_MODEL=all-MiniLM-L6-v2

# --- Pinecone (RAG) ---
PINECONE_API_KEY=
PINECONE_INDEX=
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

